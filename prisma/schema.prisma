generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ======================================================
// EMPRESA - CLIENTE
// ======================================================

model Empresa {
  id String @id @default(uuid())

  // Identificación
  nit    String @unique @db.VarChar(30)
  nombre String @db.VarChar(191)

  // Información general
  fechaInicio        DateTime? @db.Date
  direccionPrincipal String?   @db.VarChar(255)
  ciudadPrincipal    String?   @db.VarChar(120)
  correoEmpresa      String?   @db.VarChar(191)
  descripcionEmpresa String?   @db.Text

  // Actividad económica
  claseRiesgoPrincipal          ClaseRiesgo?
  codigoActividadEconomica      String?      @db.VarChar(30)
  descripcionActividadEconomica String?      @db.Text

  // Gerencia
  nombreGerente String? @db.VarChar(191)
  correoGerente String? @db.VarChar(191)

  // Contacto SST
  nombreContactoSst String? @db.VarChar(191)
  correoContactoSst String? @db.VarChar(191)

  // Visitas convenidas
  visitasSstConvenidas         Int @default(0)
  visitasEmergenciasConvenidas Int @default(0)

  // Estado
  activo Boolean @default(true)

  // Relaciones
  usuarios                  Usuario[]
  asignacionesProfesionales EmpresaProfesional[]
  periodosSgsst             EmpresaPeriodo[]
  compromisos               Compromiso[]
  permisosClienteAspecto    PermisoClienteAspecto[]

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([nombre])
  @@index([ciudadPrincipal])
  @@index([correoEmpresa])
  @@index([activo])
}

// ======================================================
// PROFESIONAL - PRESTADOR
// ======================================================

model Profesional {
  id String @id @default(uuid())

  // Identificación
  tipoIdentificacion   TipoIdentificacion
  numeroIdentificacion String             @unique @db.VarChar(40)

  // Información personal
  nombres   String @db.VarChar(120)
  apellidos String @db.VarChar(120)

  // Información laboral
  cargo          String? @db.VarChar(150)
  profesion      String? @db.VarChar(191)
  rolProfesional String? @db.VarChar(150)

  // Información de contacto
  correo    String  @unique @db.VarChar(191)
  celular   String? @db.VarChar(30)
  direccion String? @db.VarChar(255)

  // Estado
  activo Boolean @default(true)

  // Usuario opcional para iniciar sesión
  usuarioId String?  @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  // Empresas asignadas
  asignacionesEmpresas EmpresaProfesional[]

  // Gestiones SG-SST realizadas
  gestionesSgsst GestionSgsst[]

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([apellidos, nombres])
  @@index([profesion])
  @@index([rolProfesional])
  @@index([activo])
}

// ======================================================
// ASIGNACIÓN PROFESIONAL - EMPRESA
// ======================================================

model EmpresaProfesional {
  id String @id @default(uuid())

  empresaId     String
  profesionalId String

  empresa     Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  profesional Profesional @relation(fields: [profesionalId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Información de la asignación
  rolAsignacion         String?   @db.VarChar(150)
  esProfesionalAsignado Boolean   @default(false)
  fechaInicio           DateTime? @db.Date
  fechaFin              DateTime? @db.Date
  activo                Boolean   @default(true)

  // Categorías que puede gestionar en esta empresa
  categoriasGestion EmpresaProfesionalCategoriaGestion[]

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([empresaId, profesionalId], map: "uq_empresa_profesional")
  @@index([empresaId])
  @@index([profesionalId])
  @@index([empresaId, esProfesionalAsignado, activo])
  @@index([activo])
}

// ======================================================
// USUARIOS Y AUTENTICACIÓN
// ======================================================

model Usuario {
  id String @id @default(uuid())

  // Credenciales
  correo     String @unique @db.VarChar(191)
  contrasena String @db.VarChar(255)

  // Información básica
  nombre String     @db.VarChar(191)
  rol    RolUsuario @default(USUARIO)

  // Empresa cliente opcional
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  // Perfil profesional opcional
  profesional Profesional?

  // Historial de cambios realizados sobre la Supermatriz
  historialCambiosSupermatriz HistorialCambioSupermatriz[]

  // Operación SG-SST por empresa
  periodosSgsstCreados          EmpresaPeriodo[]            @relation("EmpresaPeriodoCreadoPor")
  gestionesSgsstCreadas         GestionSgsst[]              @relation("GestionSgsstCreadaPor")
  evaluacionesRegistradas       EvaluacionAspecto[]         @relation("EvaluacionRegistradaPor")
  historialEvaluaciones         HistorialEvaluacion[]       @relation("HistorialEvaluacionUsuario")
  evidenciasEvaluacion          EvidenciaEvaluacion[]       @relation("EvidenciaEvaluacionCreadaPor")
  revisionesTecnicasSolicitadas RevisionTecnicaEvaluacion[] @relation("RevisionTecnicaSolicitadaPor")
  revisionesTecnicasResueltas   RevisionTecnicaEvaluacion[] @relation("RevisionTecnicaResueltaPor")
  informesPeriodoGenerados      InformePeriodoSgsst[]       @relation("InformePeriodoGeneradoPor")
  decisionesNoAplicaSolicitadas DecisionNoAplica[]          @relation("DecisionNoAplicaSolicitadaPor")
  decisionesNoAplicaResueltas   DecisionNoAplica[]          @relation("DecisionNoAplicaDecididaPor")
  aprobacionesGestionDecididas  AprobacionGestion[]         @relation("AprobacionGestionDecididaPor")

  // Compromisos y permisos por aspecto
  compromisosCreados                Compromiso[]                     @relation("CompromisoCreadoPor")
  compromisosCancelados             Compromiso[]                     @relation("CompromisoCanceladoPor")
  responsabilidadesCompromiso       CompromisoResponsable[]          @relation("CompromisoUsuarioResponsable")
  asignacionesCompromisoRealizadas  CompromisoResponsable[]          @relation("CompromisoResponsableAsignadoPor")
  actividadesCompromisoAtendidas    ActividadCompromiso[]            @relation("ActividadCompromisoAtendidaPor")
  seguimientosCompromiso            SeguimientoCompromiso[]          @relation("SeguimientoCompromisoRegistradoPor")
  evidenciasCompromiso              CompromisoEvidencia[]            @relation("CompromisoEvidenciaCreadaPor")
  cierresCompromisoSolicitados      SolicitudCierreCompromiso[]      @relation("CierreCompromisoSolicitadoPor")
  cierresCompromisoDecididos        SolicitudCierreCompromiso[]      @relation("CierreCompromisoDecididoPor")
  ampliacionesCompromisoSolicitadas SolicitudAmpliacionCompromiso[]  @relation("AmpliacionCompromisoSolicitadaPor")
  ampliacionesCompromisoDecididas   AprobacionAmpliacionCompromiso[] @relation("AmpliacionCompromisoDecididaPor")
  historialCompromisos              HistorialCompromiso[]            @relation("HistorialCompromisoUsuario")
  permisosClienteAspecto            PermisoClienteAspecto[]          @relation("PermisoClienteAspectoUsuario")
  permisosClienteAspectoOtorgados   PermisoClienteAspecto[]          @relation("PermisoClienteAspectoOtorgadoPor")

  // Estado
  activo Boolean @default(true)

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([empresaId])
  @@index([rol])
  @@index([activo])
}

// ======================================================
// ENUMERACIONES GENERALES
// ======================================================

enum RolUsuario {
  USUARIO
  USUARIO_CLIENTE
  ADMIN_CLIENTE
  PROFESIONAL
  COORDINADOR
  ADMIN
  PROPIETARIO
  SUPERADMIN
}

enum TipoIdentificacion {
  CC
  CE
  TI
  PPT
  PASAPORTE
  NIT
  OTRO
}

enum ClaseRiesgo {
  I
  II
  III
  IV
  V
}

enum EstadoRegistro {
  ACTIVO
  INACTIVO
}

enum EstadoVersionSupermatriz {
  BORRADOR
  VIGENTE
  CERRADA
}

enum BloqueEvergreen {
  PRIMER_CUATRIMESTRE
  SEGUNDO_CUATRIMESTRE
  TERCER_CUATRIMESTRE
}

enum TipoFechaBaseVigencia {
  FECHA_DOCUMENTO
  FECHA_ULTIMA_REVISION
  FECHA_FIJA_CALENDARIO
}

enum UnidadPeriodicidad {
  DIA
  SEMANA
  MES
  ANIO
}

enum FuentePeriodicidad {
  NORMATIVA
  DIRECTRIZ_INTERNA
  CONFIGURACION_TECNICA
}

enum CodigoCategoriaGestion {
  DOCUMENTAL
  INTERVENCION
  EMERGENCIAS
}

enum CodigoGrupoMinisterial {
  ESTANDARES_7
  ESTANDARES_21
  ESTANDARES_60
}

enum ModalidadGestion {
  PRESENCIAL
  REMOTA
  OFICINA
  SEGUIMIENTO_PUNTUAL
}

enum EstadoPeriodoSgsst {
  ABIERTO
  CERRADO
}

enum EstadoGestionSgsst {
  BORRADOR
  FINALIZADA
  INVALIDADA
}

enum EstadoCumplimientoAspecto {
  CUMPLIDO
  PARCIAL
  NO_CUMPLIDO
  NO_APLICA
}

enum EstadoRevisionTecnica {
  PENDIENTE
  APROBADA
  REQUIERE_AJUSTES
  ANULADA
}

enum EstadoDecisionNoAplica {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum EstadoAprobacionGestion {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum EstadoCompromiso {
  EN_EJECUCION
  PENDIENTE_DE_REASIGNACION
  SOLICITUD_DE_CIERRE
  CUMPLIDO
  CANCELADO
}

enum TipoResponsableCompromiso {
  PRINCIPAL
  APOYO
}

enum EstadoAsignacionCompromiso {
  ASIGNADA
  RECHAZADA
  REEMPLAZADA
}

enum EstadoActividadCompromiso {
  PENDIENTE
  ATENDIDA
  ANULADA
}

enum OrigenSeguimientoCompromiso {
  INTERNO
  CLIENTE
}

enum EstadoSolicitudCierreCompromiso {
  PENDIENTE
  APROBADA
  DEVUELTA
}

enum EstadoSolicitudAmpliacionCompromiso {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum TipoAprobadorAmpliacionCompromiso {
  COORDINADOR
  ADMINISTRADOR
}

enum DecisionAmpliacionCompromiso {
  APROBADA
  RECHAZADA
}

// ======================================================
// SUPERMATRIZ NORMALIZADA
// ======================================================

model CicloPhva {
  id                   Int            @id @default(autoincrement())
  versionSupermatrizId Int
  codigo               String         @db.VarChar(20)
  nombre               String         @db.VarChar(100)
  orden                Int
  porcentajeEsperado   Decimal?       @db.Decimal(5, 2)
  estado               EstadoRegistro @default(ACTIVO)
  createdAt            DateTime       @default(now()) @db.DateTime(3)
  updatedAt            DateTime       @updatedAt @db.DateTime(3)

  versionSupermatriz VersionSupermatriz  @relation(fields: [versionSupermatrizId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categorias         CategoriaEstandar[]

  @@unique([versionSupermatrizId, codigo])
  @@unique([versionSupermatrizId, nombre])
  @@index([versionSupermatrizId, orden])
  @@index([estado])
  @@map("ciclos_phva")
}

model CategoriaEstandar {
  id                   Int            @id @default(autoincrement())
  versionSupermatrizId Int
  cicloPhvaId          Int
  codigo               String?        @db.VarChar(50)
  nombre               String         @db.VarChar(191)
  descripcion          String?        @db.Text
  orden                 Int
  porcentajeEsperado   Decimal?       @db.Decimal(5, 2)
  estado               EstadoRegistro @default(ACTIVO)
  createdAt            DateTime       @default(now()) @db.DateTime(3)
  updatedAt            DateTime       @updatedAt @db.DateTime(3)

  versionSupermatriz VersionSupermatriz @relation(fields: [versionSupermatrizId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cicloPhva          CicloPhva          @relation(fields: [cicloPhvaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  estandares         Estandar[]

  @@unique([versionSupermatrizId, cicloPhvaId, nombre])
  @@index([versionSupermatrizId])
  @@index([cicloPhvaId, orden])
  @@index([estado])
}

model Estandar {
  id                              Int            @id @default(autoincrement())
  versionSupermatrizId            Int
  categoriaEstandarId             Int
  codigo                          String?        @db.VarChar(50)
  nombre                          String         @db.VarChar(191)
  descripcion                     String?        @db.Text
  orden                           Int
  calificacionMinisterialEsperada Decimal?       @db.Decimal(5, 2)
  estado                          EstadoRegistro @default(ACTIVO)
  createdAt                       DateTime       @default(now()) @db.DateTime(3)
  updatedAt                       DateTime       @updatedAt @db.DateTime(3)

  versionSupermatriz  VersionSupermatriz         @relation(fields: [versionSupermatrizId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoriaEstandar   CategoriaEstandar          @relation(fields: [categoriaEstandarId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  aspectos            Aspecto[]
  gruposMinisteriales EstandarGrupoMinisterial[]

  @@unique([versionSupermatrizId, categoriaEstandarId, nombre])
  @@index([versionSupermatrizId])
  @@index([categoriaEstandarId, orden])
  @@index([estado])
}

model Proceso {
  id                   Int            @id @default(autoincrement())
  versionSupermatrizId Int
  codigo               String?        @db.VarChar(50)
  nombre               String         @db.VarChar(191)
  descripcion          String?        @db.Text
  estado               EstadoRegistro @default(ACTIVO)
  createdAt            DateTime       @default(now()) @db.DateTime(3)
  updatedAt            DateTime       @updatedAt @db.DateTime(3)

  versionSupermatriz VersionSupermatriz @relation(fields: [versionSupermatrizId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tareas             SupermatrizTarea[]

  @@unique([versionSupermatrizId, nombre])
  @@index([versionSupermatrizId])
  @@index([estado])
}

model Aspecto {
  id                              Int            @id @default(autoincrement())
  versionSupermatrizId            Int
  estandarId                      Int
  codigo                          String?        @db.VarChar(50)
  nombre                          String         @db.VarChar(191)
  descripcion                     String?        @db.Text
  orden                           Int
  calificacionMinisterialEsperada Decimal?       @db.Decimal(5, 2)
  estado                          EstadoRegistro @default(ACTIVO)
  createdAt                       DateTime       @default(now()) @db.DateTime(3)
  updatedAt                       DateTime       @updatedAt @db.DateTime(3)

  versionSupermatriz          VersionSupermatriz             @relation(fields: [versionSupermatrizId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  estandar                    Estandar                       @relation(fields: [estandarId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  planAccionEspecifico        PlanAccionEspecifico?
  tareas                      SupermatrizTarea[]
  configuracion               ConfiguracionAspecto?
  configuracionVigencia       ConfiguracionVigenciaAspecto?
  configuracionTareaCotidiana ConfiguracionTareaCotidiana?
  configuracionEvidencia      ConfiguracionEvidenciaAspecto?
  configuracionRevision       ConfiguracionRevisionTecnica?
  palabrasClave               AspectoPalabraClave[]
  requisitosNormativos        AspectoRequisitoNormativo[]
  reglasAprobacion            ReglaAprobacionGestion[]
  vigencias                   VigenciaAspecto[]
  evaluaciones                EvaluacionAspecto[]
  compromisos                 Compromiso[]
  permisosClienteAspecto      PermisoClienteAspecto[]

  @@unique([versionSupermatrizId, estandarId, nombre])
  @@index([versionSupermatrizId])
  @@index([estandarId, orden])
  @@index([estado])
}

model PlanAccionEspecifico {
  id          Int            @id @default(autoincrement())
  aspectoId   Int            @unique
  descripcion String         @db.Text
  estado      EstadoRegistro @default(ACTIVO)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)

  aspecto Aspecto @relation(fields: [aspectoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([estado])
}

model VersionSupermatriz {
  id           Int                      @id @default(autoincrement())
  clonadaDeId  Int?
  nombre       String                   @unique @db.VarChar(100)
  descripcion  String?                  @db.Text
  estado       EstadoVersionSupermatriz @default(BORRADOR)
  vigenteDesde DateTime?                @db.Date
  vigenteHasta DateTime?                @db.Date
  createdAt    DateTime                 @default(now()) @db.DateTime(3)
  updatedAt    DateTime                 @updatedAt @db.DateTime(3)

  clonadaDe VersionSupermatriz?  @relation("VersionClonada", fields: [clonadaDeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  clones    VersionSupermatriz[] @relation("VersionClonada")

  ciclosPhva           CicloPhva[]
  categoriasEstandar   CategoriaEstandar[]
  estandares           Estandar[]
  aspectos             Aspecto[]
  procesos             Proceso[]
  palabrasClave        PalabraClave[]
  requisitosNormativos RequisitoNormativo[]
  tareas               SupermatrizTarea[]
  cambios              HistorialCambioSupermatriz[]
  periodosEmpresa      EmpresaPeriodo[]

  @@index([clonadaDeId])
  @@index([estado])
  @@index([vigenteDesde, vigenteHasta])
}

model SupermatrizTarea {
  id                   Int     @id @default(autoincrement())
  versionSupermatrizId Int
  aspectoId            Int
  procesoId            Int
  codigo               String? @db.VarChar(50)
  orden                Int

  // Información operativa de la fila maestra
  ejecucion               String? @db.Text
  fundamentosSoportes     String? @db.Text
  responsableActividad    String? @db.VarChar(255)
  metasEstandar           String? @db.Text
  recursosAdministrativos String? @db.Text

  estado    EstadoRegistro @default(ACTIVO)
  createdAt DateTime       @default(now()) @db.DateTime(3)
  updatedAt DateTime       @updatedAt @db.DateTime(3)

  versionSupermatriz   VersionSupermatriz                 @relation(fields: [versionSupermatrizId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  aspecto              Aspecto                            @relation(fields: [aspectoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  proceso              Proceso                            @relation(fields: [procesoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoriasGestion    SupermatrizTareaCategoriaGestion[]
  evaluacionesContexto EvaluacionAspecto[]

  @@unique([versionSupermatrizId, aspectoId, procesoId])
  @@index([versionSupermatrizId, orden])
  @@index([aspectoId])
  @@index([procesoId])
  @@index([estado])
}

// ======================================================
// CATEGORÍAS DE GESTIÓN
// ======================================================

model CategoriaGestion {
  id          Int                    @id @default(autoincrement())
  codigo      CodigoCategoriaGestion @unique
  nombre      String                 @db.VarChar(100)
  descripcion String?                @db.Text
  estado      EstadoRegistro         @default(ACTIVO)
  createdAt   DateTime               @default(now()) @db.DateTime(3)
  updatedAt   DateTime               @updatedAt @db.DateTime(3)

  tareas                  SupermatrizTareaCategoriaGestion[]
  asignacionesProfesional EmpresaProfesionalCategoriaGestion[]
  gestiones               GestionSgsst[]

  @@index([estado])
}

model SupermatrizTareaCategoriaGestion {
  supermatrizTareaId Int
  categoriaGestionId Int
  createdAt          DateTime @default(now()) @db.DateTime(3)

  supermatrizTarea SupermatrizTarea @relation(fields: [supermatrizTareaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  categoriaGestion CategoriaGestion @relation(fields: [categoriaGestionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([supermatrizTareaId, categoriaGestionId])
  @@index([categoriaGestionId])
}

model EmpresaProfesionalCategoriaGestion {
  empresaProfesionalId String
  categoriaGestionId   Int
  createdAt            DateTime @default(now()) @db.DateTime(3)

  empresaProfesional EmpresaProfesional @relation(fields: [empresaProfesionalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  categoriaGestion   CategoriaGestion   @relation(fields: [categoriaGestionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([empresaProfesionalId, categoriaGestionId])
  @@index([categoriaGestionId])
}

// ======================================================
// GRUPOS MINISTERIALES
// Se aplican a los estándares, no a las empresas.
// ======================================================

model GrupoMinisterial {
  id                    Int                    @id @default(autoincrement())
  codigo                CodigoGrupoMinisterial @unique
  nombre                String                 @db.VarChar(100)
  porcentajeEvaluable   Decimal                @db.Decimal(5, 2)
  porcentajeComplemento Decimal                @db.Decimal(5, 2)
  estado                EstadoRegistro         @default(ACTIVO)
  createdAt             DateTime               @default(now()) @db.DateTime(3)
  updatedAt             DateTime               @updatedAt @db.DateTime(3)

  estandares EstandarGrupoMinisterial[]

  @@index([estado])
}

model EstandarGrupoMinisterial {
  estandarId         Int
  grupoMinisterialId Int
  createdAt          DateTime @default(now()) @db.DateTime(3)

  estandar         Estandar         @relation(fields: [estandarId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  grupoMinisterial GrupoMinisterial @relation(fields: [grupoMinisterialId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([estandarId, grupoMinisterialId])
  @@index([grupoMinisterialId])
}

// ======================================================
// CONFIGURACIONES POR ASPECTO
// ======================================================

model ConfiguracionAspecto {
  id                              Int              @id @default(autoincrement())
  aspectoId                       Int              @unique
  esEvergreen                     Boolean          @default(false)
  bloqueEvergreen                 BloqueEvergreen?
  documentoActualizacionPeriodica Boolean          @default(false)
  tareaEjecucionCotidiana         Boolean          @default(false)
  incluirInformeEstadoTareas      Boolean          @default(false)
  permiteNoAplica                 Boolean          @default(true)
  estado                          EstadoRegistro   @default(ACTIVO)
  createdAt                       DateTime         @default(now()) @db.DateTime(3)
  updatedAt                       DateTime         @updatedAt @db.DateTime(3)

  aspecto Aspecto @relation(fields: [aspectoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([esEvergreen])
  @@index([tareaEjecucionCotidiana])
  @@index([incluirInformeEstadoTareas])
}

model ConfiguracionVigenciaAspecto {
  id                 Int                   @id @default(autoincrement())
  aspectoId          Int                   @unique
  tipoFechaBase      TipoFechaBaseVigencia @default(FECHA_DOCUMENTO)
  fuentePeriodicidad FuentePeriodicidad    @default(CONFIGURACION_TECNICA)
  cantidad           Int?
  unidad             UnidadPeriodicidad?
  diasAlertaPrevia   Int                   @default(30)
  permiteFechaManual Boolean               @default(true)
  mesFechaFija       Int?
  diaFechaFija       Int?
  descripcionRegla   String?               @db.Text
  estado             EstadoRegistro        @default(ACTIVO)
  createdAt          DateTime               @default(now()) @db.DateTime(3)
  updatedAt          DateTime               @updatedAt @db.DateTime(3)

  aspecto Aspecto @relation(fields: [aspectoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tipoFechaBase])
  @@index([fuentePeriodicidad])
}

model ConfiguracionTareaCotidiana {
  id               Int                @id @default(autoincrement())
  aspectoId        Int                @unique
  cantidadObjetivo Int
  unidad           UnidadPeriodicidad
  descripcion      String?            @db.Text
  estado           EstadoRegistro     @default(ACTIVO)
  createdAt        DateTime           @default(now()) @db.DateTime(3)
  updatedAt        DateTime           @updatedAt @db.DateTime(3)

  aspecto Aspecto @relation(fields: [aspectoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model ConfiguracionEvidenciaAspecto {
  id                    Int            @id @default(autoincrement())
  aspectoId             Int            @unique
  requiereEvidencia     Boolean        @default(false)
  descripcionEvidencia  String?        @db.Text
  visibleClienteDefault Boolean        @default(false)
  estado                EstadoRegistro @default(ACTIVO)
  createdAt             DateTime       @default(now()) @db.DateTime(3)
  updatedAt             DateTime       @updatedAt @db.DateTime(3)

  aspecto Aspecto @relation(fields: [aspectoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([requiereEvidencia])
}

model ConfiguracionRevisionTecnica {
  id                      Int            @id @default(autoincrement())
  aspectoId               Int            @unique
  requiereRevisionTecnica Boolean        @default(false)
  observaciones           String?        @db.Text
  estado                  EstadoRegistro @default(ACTIVO)
  createdAt               DateTime       @default(now()) @db.DateTime(3)
  updatedAt               DateTime       @updatedAt @db.DateTime(3)

  aspecto Aspecto @relation(fields: [aspectoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([requiereRevisionTecnica])
}

model ReglaAprobacionGestion {
  id                 Int               @id @default(autoincrement())
  aspectoId          Int?
  modalidad          ModalidadGestion?
  tipoActividad      String?           @db.VarChar(191)
  criterio           String            @db.Text
  requiereAprobacion Boolean           @default(true)
  vigenteDesde       DateTime?         @db.Date
  vigenteHasta       DateTime?         @db.Date
  estado             EstadoRegistro    @default(ACTIVO)
  createdAt          DateTime           @default(now()) @db.DateTime(3)
  updatedAt          DateTime           @updatedAt @db.DateTime(3)

  aspecto Aspecto? @relation(fields: [aspectoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([aspectoId])
  @@index([modalidad])
  @@index([estado])
}

// ======================================================
// PALABRAS CLAVE Y REQUISITOS NORMATIVOS
// ======================================================

model PalabraClave {
  id                   Int      @id @default(autoincrement())
  versionSupermatrizId Int
  nombre               String   @db.VarChar(100)
  createdAt            DateTime @default(now()) @db.DateTime(3)
  updatedAt            DateTime @updatedAt @db.DateTime(3)

  versionSupermatriz VersionSupermatriz    @relation(fields: [versionSupermatrizId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  aspectos           AspectoPalabraClave[]

  @@unique([versionSupermatrizId, nombre])
  @@index([versionSupermatrizId])
}

model AspectoPalabraClave {
  aspectoId      Int
  palabraClaveId Int
  createdAt      DateTime @default(now()) @db.DateTime(3)

  aspecto      Aspecto      @relation(fields: [aspectoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  palabraClave PalabraClave @relation(fields: [palabraClaveId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([aspectoId, palabraClaveId])
  @@index([palabraClaveId])
}

model RequisitoNormativo {
  id                   Int            @id @default(autoincrement())
  versionSupermatrizId Int
  clave                String         @db.VarChar(255)
  norma                String         @db.VarChar(191)
  articulo             String?        @db.VarChar(100)
  descripcion          String?        @db.Text
  estado               EstadoRegistro @default(ACTIVO)
  createdAt            DateTime       @default(now()) @db.DateTime(3)
  updatedAt            DateTime       @updatedAt @db.DateTime(3)

  versionSupermatriz VersionSupermatriz          @relation(fields: [versionSupermatrizId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  aspectos           AspectoRequisitoNormativo[]

  @@unique([versionSupermatrizId, clave])
  @@index([versionSupermatrizId])
  @@index([estado])
}

model AspectoRequisitoNormativo {
  aspectoId            Int
  requisitoNormativoId Int
  createdAt            DateTime @default(now()) @db.DateTime(3)

  aspecto            Aspecto            @relation(fields: [aspectoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  requisitoNormativo RequisitoNormativo @relation(fields: [requisitoNormativoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([aspectoId, requisitoNormativoId])
  @@index([requisitoNormativoId])
}

// ======================================================
// OPERACIÓN SG-SST POR EMPRESA
// ======================================================

model EmpresaPeriodo {
  id                   String             @id @default(uuid())
  empresaId            String
  versionSupermatrizId Int
  anio                 Int
  estado               EstadoPeriodoSgsst @default(ABIERTO)
  fechaApertura        DateTime           @default(now()) @db.DateTime(3)
  fechaCierre          DateTime?          @db.DateTime(3)
  creadoPorUsuarioId   String
  createdAt            DateTime           @default(now()) @db.DateTime(3)
  updatedAt            DateTime           @updatedAt @db.DateTime(3)

  empresa            Empresa               @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versionSupermatriz VersionSupermatriz    @relation(fields: [versionSupermatrizId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creadoPor          Usuario               @relation("EmpresaPeriodoCreadoPor", fields: [creadoPorUsuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  gestiones          GestionSgsst[]
  informes           InformePeriodoSgsst[]

  @@unique([empresaId, anio], map: "uq_empresa_periodo_anio")
  @@index([empresaId, estado])
  @@index([versionSupermatrizId])
  @@index([anio])
  @@index([creadoPorUsuarioId])
}

model InformePeriodoSgsst {
  id                             String                  @id @default(uuid())
  empresaPeriodoId               String
  numeroVersion                  Int
  titulo                         String                  @db.VarChar(191)
  grupoMinisterial               CodigoGrupoMinisterial?
  categoriasGestion              Json
  motivoVersion                  String?                 @db.Text
  fechaCorte                     DateTime                @default(now()) @db.DateTime(3)
  ultimaActualizacionFuente      DateTime?               @db.DateTime(3)
  totalGestionesFuente           Int                     @default(0)
  totalEvaluacionesFuente        Int                     @default(0)
  registrosHistoricosPosteriores Int                     @default(0)
  cumplimientoAdministrativo     Decimal?                @db.Decimal(5, 2)
  calificacionMinisterial        Decimal?                @db.Decimal(7, 2)
  calificacionMinisterialMaxima  Decimal?                @db.Decimal(7, 2)
  coberturaPorcentaje            Decimal?                @db.Decimal(5, 2)
  snapshot                       Json
  generadoPorUsuarioId           String
  createdAt                      DateTime                @default(now()) @db.DateTime(3)
  updatedAt                      DateTime                @updatedAt @db.DateTime(3)

  empresaPeriodo EmpresaPeriodo @relation(fields: [empresaPeriodoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  generadoPor    Usuario        @relation("InformePeriodoGeneradoPor", fields: [generadoPorUsuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([empresaPeriodoId, numeroVersion], map: "uq_informe_periodo_version")
  @@index([empresaPeriodoId, createdAt])
  @@index([generadoPorUsuarioId])
  @@index([grupoMinisterial])
  @@index([fechaCorte])
}

model GestionSgsst {
  id                 String             @id @default(uuid())
  empresaPeriodoId   String
  profesionalId      String?
  categoriaGestionId Int?
  usuarioCreadorId   String
  fechaGestion       DateTime           @db.Date
  modalidad          ModalidadGestion
  tipoActividad      String             @db.VarChar(191)
  observacionGeneral String?            @db.Text
  estado             EstadoGestionSgsst @default(BORRADOR)
  valida             Boolean            @default(true)
  finalizadaEn       DateTime?          @db.DateTime(3)
  invalidadaEn       DateTime?          @db.DateTime(3)
  motivoInvalidacion String?            @db.Text
  createdAt          DateTime           @default(now()) @db.DateTime(3)
  updatedAt          DateTime           @updatedAt @db.DateTime(3)

  empresaPeriodo        EmpresaPeriodo        @relation(fields: [empresaPeriodoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  profesional           Profesional?          @relation(fields: [profesionalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoriaGestion      CategoriaGestion?     @relation(fields: [categoriaGestionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuarioCreador        Usuario               @relation("GestionSgsstCreadaPor", fields: [usuarioCreadorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  evaluaciones          EvaluacionAspecto[]
  historial             HistorialEvaluacion[]
  compromisosOriginados Compromiso[]
  aprobacion            AprobacionGestion?

  @@index([empresaPeriodoId, fechaGestion])
  @@index([profesionalId])
  @@index([categoriaGestionId])
  @@index([usuarioCreadorId])
  @@index([estado, valida])
}

model EvaluacionAspecto {
  id                         String                    @id @default(uuid())
  gestionId                  String
  aspectoId                  Int
  supermatrizTareaId         Int?
  usuarioRegistradorId       String
  estadoCumplimiento         EstadoCumplimientoAspecto
  calificacionAdministrativa Decimal                   @db.Decimal(3, 2)
  observacion                String?                   @db.Text
  fechaDocumento             DateTime?                 @db.Date
  fechaVencimientoCalculada  DateTime?                 @db.Date
  justificacionNoAplica      String?                   @db.Text
  marcadaRevisionTecnica     Boolean                   @default(false)
  motivoRevisionTecnica      String?                   @db.Text
  createdAt                  DateTime                  @default(now()) @db.DateTime(3)
  updatedAt                  DateTime                  @updatedAt @db.DateTime(3)

  gestion                     GestionSgsst                      @relation(fields: [gestionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  aspecto                     Aspecto                           @relation(fields: [aspectoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supermatrizTarea            SupermatrizTarea?                 @relation(fields: [supermatrizTareaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  usuarioRegistrador          Usuario                           @relation("EvaluacionRegistradaPor", fields: [usuarioRegistradorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  historial                   HistorialEvaluacion[]
  evidencias                  EvidenciaEvaluacion[]
  revisionTecnica             RevisionTecnicaEvaluacion?
  decisionNoAplica            DecisionNoAplica?
  aprobacionGestion           AprobacionGestionEvaluacion?
  compromisoOrigen            Compromiso?                       @relation("CompromisoEvaluacionOrigen")
  seguimientosCompromiso      CompromisoEvaluacionSeguimiento[]
  solicitudesCierreCompromiso SolicitudCierreCompromiso[]       @relation("CierreCompromisoEvaluacion")

  @@unique([gestionId, aspectoId], map: "uq_gestion_aspecto")
  @@index([gestionId])
  @@index([aspectoId, createdAt])
  @@index([supermatrizTareaId])
  @@index([usuarioRegistradorId])
  @@index([estadoCumplimiento])
  @@index([fechaVencimientoCalculada])
}

model EvidenciaEvaluacion {
  id               String    @id @default(uuid())
  evaluacionId     String
  nombre           String    @db.VarChar(191)
  url              String    @db.Text
  descripcion      String?   @db.Text
  fechaDocumento   DateTime? @db.Date
  visibleCliente   Boolean   @default(false)
  activo           Boolean   @default(true)
  usuarioCreadorId String
  createdAt        DateTime  @default(now()) @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @db.DateTime(3)

  evaluacion           EvaluacionAspecto     @relation(fields: [evaluacionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuarioCreador       Usuario               @relation("EvidenciaEvaluacionCreadaPor", fields: [usuarioCreadorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  evidenciasCompromiso CompromisoEvidencia[]

  @@index([evaluacionId, activo])
  @@index([usuarioCreadorId])
  @@index([visibleCliente])
  @@index([fechaDocumento])
}

model RevisionTecnicaEvaluacion {
  id                     String                @id @default(uuid())
  evaluacionId           String                @unique
  solicitadaPorUsuarioId String
  revisadaPorUsuarioId   String?
  estado                 EstadoRevisionTecnica @default(PENDIENTE)
  motivoSolicitud        String                @db.Text
  conceptoTecnico        String?               @db.Text
  motivoAnulacion        String?               @db.Text
  solicitadaEn           DateTime              @default(now()) @db.DateTime(3)
  revisadaEn             DateTime?             @db.DateTime(3)
  anuladaEn              DateTime?             @db.DateTime(3)
  createdAt              DateTime              @default(now()) @db.DateTime(3)
  updatedAt              DateTime              @updatedAt @db.DateTime(3)

  evaluacion    EvaluacionAspecto @relation(fields: [evaluacionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  solicitadaPor Usuario           @relation("RevisionTecnicaSolicitadaPor", fields: [solicitadaPorUsuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revisadaPor   Usuario?          @relation("RevisionTecnicaResueltaPor", fields: [revisadaPorUsuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([estado, solicitadaEn])
  @@index([solicitadaPorUsuarioId])
  @@index([revisadaPorUsuarioId])
}

model HistorialEvaluacion {
  id           String   @id @default(uuid())
  gestionId    String
  evaluacionId String?
  usuarioId    String
  accion       String   @db.VarChar(100)
  descripcion  String?  @db.Text
  datosAntes   Json?
  datosDespues Json?
  createdAt    DateTime @default(now()) @db.DateTime(3)

  gestion    GestionSgsst       @relation(fields: [gestionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  evaluacion EvaluacionAspecto? @relation(fields: [evaluacionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  usuario    Usuario            @relation("HistorialEvaluacionUsuario", fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([gestionId, createdAt])
  @@index([evaluacionId])
  @@index([usuarioId])
}

model DecisionNoAplica {
  id                      String                 @id @default(uuid())
  evaluacionId            String                 @unique
  solicitadaPorUsuarioId  String
  decididaPorUsuarioId    String?
  estado                  EstadoDecisionNoAplica @default(PENDIENTE)
  resultadoEfectivo       Decimal                @default(3.00) @db.Decimal(3, 2)
  observacionDecision     String?                @db.Text
  solicitadaEn            DateTime               @default(now()) @db.DateTime(3)
  decididaEn              DateTime?              @db.DateTime(3)
  createdAt               DateTime               @default(now()) @db.DateTime(3)
  updatedAt               DateTime               @updatedAt @db.DateTime(3)

  evaluacion   EvaluacionAspecto @relation(fields: [evaluacionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  solicitadaPor Usuario          @relation("DecisionNoAplicaSolicitadaPor", fields: [solicitadaPorUsuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decididaPor   Usuario?         @relation("DecisionNoAplicaDecididaPor", fields: [decididaPorUsuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([estado, solicitadaEn])
  @@index([solicitadaPorUsuarioId])
  @@index([decididaPorUsuarioId])
  @@map("decisiones_no_aplica")
}

model AprobacionGestion {
  id                     String                   @id @default(uuid())
  gestionId              String                   @unique
  decididaPorUsuarioId   String?
  estado                 EstadoAprobacionGestion  @default(PENDIENTE)
  reglasAplicadas        Json
  observacionDecision    String?                  @db.Text
  generadaEn             DateTime                 @default(now()) @db.DateTime(3)
  decididaEn             DateTime?                @db.DateTime(3)
  createdAt              DateTime                 @default(now()) @db.DateTime(3)
  updatedAt              DateTime                 @updatedAt @db.DateTime(3)

  gestion      GestionSgsst                  @relation(fields: [gestionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decididaPor  Usuario?                      @relation("AprobacionGestionDecididaPor", fields: [decididaPorUsuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  evaluaciones AprobacionGestionEvaluacion[]

  @@index([estado, generadaEn])
  @@index([decididaPorUsuarioId])
  @@map("aprobaciones_gestion")
}

model AprobacionGestionEvaluacion {
  aprobacionGestionId String
  evaluacionId        String   @unique
  createdAt           DateTime @default(now()) @db.DateTime(3)

  aprobacionGestion AprobacionGestion @relation(fields: [aprobacionGestionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  evaluacion        EvaluacionAspecto @relation(fields: [evaluacionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([aprobacionGestionId, evaluacionId])
  @@index([evaluacionId])
  @@map("aprobacion_gestion_evaluaciones")
}

// ======================================================
// COMPROMISOS Y SEGUIMIENTO
// ======================================================

model Compromiso {
  id                 String  @id @default(uuid())
  empresaId          String
  gestionOrigenId    String
  evaluacionOrigenId String  @unique
  aspectoId          Int
  aspectoCodigo      String? @db.VarChar(50)
  creadoPorUsuarioId String

  descripcion String           @db.Text
  recursos    String?          @db.Text
  fechaLimite DateTime         @db.Date
  estado      EstadoCompromiso @default(EN_EJECUCION)

  cerradoEn             DateTime? @db.DateTime(3)
  canceladoEn           DateTime? @db.DateTime(3)
  canceladoPorUsuarioId String?
  motivoCancelacion     String?   @db.Text

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  empresa          Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  gestionOrigen    GestionSgsst      @relation(fields: [gestionOrigenId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  evaluacionOrigen EvaluacionAspecto @relation("CompromisoEvaluacionOrigen", fields: [evaluacionOrigenId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  aspecto          Aspecto           @relation(fields: [aspectoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creadoPor        Usuario           @relation("CompromisoCreadoPor", fields: [creadoPorUsuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  canceladoPor     Usuario?          @relation("CompromisoCanceladoPor", fields: [canceladoPorUsuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  responsables            CompromisoResponsable[]
  evaluacionesSeguimiento CompromisoEvaluacionSeguimiento[]
  seguimientos            SeguimientoCompromiso[]
  evidencias              CompromisoEvidencia[]
  solicitudesCierre       SolicitudCierreCompromiso[]
  solicitudesAmpliacion   SolicitudAmpliacionCompromiso[]
  historial               HistorialCompromiso[]

  @@index([empresaId, estado, fechaLimite])
  @@index([gestionOrigenId])
  @@index([aspectoId, estado])
  @@index([empresaId, aspectoCodigo, estado])
  @@index([creadoPorUsuarioId])
  @@index([canceladoPorUsuarioId])
}

model CompromisoEvaluacionSeguimiento {
  compromisoId String
  evaluacionId String   @unique
  createdAt    DateTime @default(now()) @db.DateTime(3)

  compromiso Compromiso        @relation(fields: [compromisoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  evaluacion EvaluacionAspecto @relation(fields: [evaluacionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([compromisoId, evaluacionId])
  @@index([compromisoId, createdAt])
}

model CompromisoResponsable {
  id                   String  @id @default(uuid())
  compromisoId         String
  usuarioResponsableId String
  asignadoPorUsuarioId String
  reemplazaAId         String? @unique

  tipo   TipoResponsableCompromiso
  estado EstadoAsignacionCompromiso @default(ASIGNADA)

  asignadoEn    DateTime  @default(now()) @db.DateTime(3)
  rechazadoEn   DateTime? @db.DateTime(3)
  motivoRechazo String?   @db.Text

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  compromiso         Compromiso             @relation(fields: [compromisoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuarioResponsable Usuario                @relation("CompromisoUsuarioResponsable", fields: [usuarioResponsableId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asignadoPor        Usuario                @relation("CompromisoResponsableAsignadoPor", fields: [asignadoPorUsuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reemplazaA         CompromisoResponsable? @relation("ReasignacionCompromiso", fields: [reemplazaAId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reemplazadaPor     CompromisoResponsable? @relation("ReasignacionCompromiso")
  actividad          ActividadCompromiso?

  @@index([compromisoId, estado])
  @@index([usuarioResponsableId, estado])
  @@index([asignadoPorUsuarioId])
}

model ActividadCompromiso {
  id                      String  @id @default(uuid())
  compromisoResponsableId String  @unique
  atendidaPorUsuarioId    String?

  descripcion String                    @db.Text
  estado      EstadoActividadCompromiso @default(PENDIENTE)
  atendidaEn  DateTime?                 @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  compromisoResponsable CompromisoResponsable @relation(fields: [compromisoResponsableId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  atendidaPor           Usuario?              @relation("ActividadCompromisoAtendidaPor", fields: [atendidaPorUsuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  seguimientos          SeguimientoCompromiso[]

  @@index([estado])
  @@index([atendidaPorUsuarioId])
}

model SeguimientoCompromiso {
  id           String  @id @default(uuid())
  compromisoId String
  actividadId  String?
  usuarioId    String

  fechaSeguimiento DateTime                    @default(now()) @db.DateTime(3)
  descripcion      String                      @db.Text
  origen           OrigenSeguimientoCompromiso @default(INTERNO)
  visibleCliente   Boolean                     @default(false)

  createdAt DateTime @default(now()) @db.DateTime(3)

  compromiso Compromiso           @relation(fields: [compromisoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actividad  ActividadCompromiso? @relation(fields: [actividadId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuario    Usuario              @relation("SeguimientoCompromisoRegistradoPor", fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  evidencias CompromisoEvidencia[]

  @@index([compromisoId, fechaSeguimiento])
  @@index([actividadId])
  @@index([usuarioId])
  @@index([origen])
}

model CompromisoEvidencia {
  id                          String  @id @default(uuid())
  compromisoId                String
  seguimientoId               String?
  evidenciaEvaluacionOrigenId String?
  creadoPorUsuarioId          String

  nombre         String    @db.VarChar(191)
  url            String    @db.Text
  descripcion    String?   @db.Text
  fechaDocumento DateTime? @db.Date
  visibleCliente Boolean   @default(false)
  activa         Boolean   @default(true)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  compromiso                Compromiso             @relation(fields: [compromisoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  seguimiento               SeguimientoCompromiso? @relation(fields: [seguimientoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  evidenciaEvaluacionOrigen EvidenciaEvaluacion?   @relation(fields: [evidenciaEvaluacionOrigenId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creadoPor                 Usuario                @relation("CompromisoEvidenciaCreadaPor", fields: [creadoPorUsuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([compromisoId, activa])
  @@index([seguimientoId])
  @@index([evidenciaEvaluacionOrigenId])
  @@index([creadoPorUsuarioId])
}

model SolicitudCierreCompromiso {
  id                         String  @id @default(uuid())
  compromisoId               String
  solicitadaPorId            String
  decididaPorId              String?
  evaluacionRecalificacionId String
  numeroIntento              Int

  estado EstadoSolicitudCierreCompromiso @default(PENDIENTE)

  solicitadaEn            DateTime  @default(now()) @db.DateTime(3)
  decididaEn              DateTime? @db.DateTime(3)
  mensajeCierre           String?   @db.Text
  observacionesDevolucion String?   @db.Text

  compromiso               Compromiso        @relation(fields: [compromisoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  solicitadaPor            Usuario           @relation("CierreCompromisoSolicitadoPor", fields: [solicitadaPorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decididaPor              Usuario?          @relation("CierreCompromisoDecididoPor", fields: [decididaPorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  evaluacionRecalificacion EvaluacionAspecto @relation("CierreCompromisoEvaluacion", fields: [evaluacionRecalificacionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([compromisoId, numeroIntento])
  @@index([compromisoId, estado])
  @@index([solicitadaPorId])
  @@index([decididaPorId])
  @@index([evaluacionRecalificacionId])
}

model SolicitudAmpliacionCompromiso {
  id              String @id @default(uuid())
  compromisoId    String
  solicitadaPorId String
  numeroSolicitud Int

  fechaLimiteAnterior   DateTime                            @db.Date
  fechaLimiteSolicitada DateTime                            @db.Date
  justificacion         String                              @db.Text
  estado                EstadoSolicitudAmpliacionCompromiso @default(PENDIENTE)

  solicitadaEn DateTime  @default(now()) @db.DateTime(3)
  resueltaEn   DateTime? @db.DateTime(3)

  compromiso    Compromiso                       @relation(fields: [compromisoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  solicitadaPor Usuario                          @relation("AmpliacionCompromisoSolicitadaPor", fields: [solicitadaPorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decisiones    AprobacionAmpliacionCompromiso[]

  @@unique([compromisoId, numeroSolicitud])
  @@index([compromisoId, estado])
  @@index([solicitadaPorId])
}

model AprobacionAmpliacionCompromiso {
  id            String @id @default(uuid())
  solicitudId   String
  decididaPorId String

  tipoAprobador TipoAprobadorAmpliacionCompromiso
  decision      DecisionAmpliacionCompromiso
  observacion   String?                           @db.Text
  decididaEn    DateTime                          @default(now()) @db.DateTime(3)

  solicitud   SolicitudAmpliacionCompromiso @relation(fields: [solicitudId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decididaPor Usuario                       @relation("AmpliacionCompromisoDecididaPor", fields: [decididaPorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([solicitudId, tipoAprobador])
  @@index([decididaPorId])
}

model HistorialCompromiso {
  id           String   @id @default(uuid())
  compromisoId String
  entidadTipo  String   @db.VarChar(100)
  entidadId    String?
  accion       String   @db.VarChar(100)
  descripcion  String?  @db.Text
  datosAntes   Json?
  datosDespues Json?
  usuarioId    String
  createdAt    DateTime @default(now()) @db.DateTime(3)

  compromiso Compromiso @relation(fields: [compromisoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuario    Usuario    @relation("HistorialCompromisoUsuario", fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([compromisoId, createdAt])
  @@index([entidadTipo, entidadId])
  @@index([usuarioId])
}

model PermisoClienteAspecto {
  id               String  @id @default(uuid())
  empresaId        String
  usuarioClienteId String
  aspectoId        Int
  aspectoCodigo    String? @db.VarChar(50)
  otorgadoPorId    String

  puedeRegistrarAvances     Boolean @default(false)
  puedeCargarEvidencias     Boolean @default(false)
  puedeInformarCumplimiento Boolean @default(false)
  activo                    Boolean @default(true)

  otorgadoEn DateTime  @default(now()) @db.DateTime(3)
  revocadoEn DateTime? @db.DateTime(3)
  createdAt  DateTime  @default(now()) @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @db.DateTime(3)

  empresa        Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuarioCliente Usuario @relation("PermisoClienteAspectoUsuario", fields: [usuarioClienteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  aspecto        Aspecto @relation(fields: [aspectoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  otorgadoPor    Usuario @relation("PermisoClienteAspectoOtorgadoPor", fields: [otorgadoPorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([empresaId, usuarioClienteId, aspectoId])
  @@index([empresaId, aspectoCodigo, activo])
  @@index([usuarioClienteId, activo])
  @@index([aspectoId])
  @@index([otorgadoPorId])
}

// ======================================================
// VIGENCIAS E HISTORIAL
// ======================================================

model VigenciaAspecto {
  id                  Int            @id @default(autoincrement())
  aspectoId           Int
  vigenteDesde        DateTime       @db.Date
  vigenteHasta        DateTime?      @db.Date
  motivoDesactivacion String?        @db.Text
  estado              EstadoRegistro @default(ACTIVO)
  createdAt           DateTime       @default(now()) @db.DateTime(3)
  updatedAt           DateTime       @updatedAt @db.DateTime(3)

  aspecto Aspecto @relation(fields: [aspectoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([aspectoId, vigenteDesde, vigenteHasta])
  @@index([estado])
}

model HistorialCambioSupermatriz {
  id                   Int      @id @default(autoincrement())
  versionSupermatrizId Int?
  tipoEntidad          String   @db.VarChar(100)
  entidadId            Int?
  accion               String   @db.VarChar(100)
  descripcion          String?  @db.Text
  datosAntes           Json?
  datosDespues         Json?
  usuarioId            String?
  createdAt            DateTime @default(now()) @db.DateTime(3)

  versionSupermatriz VersionSupermatriz? @relation(fields: [versionSupermatrizId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  usuario            Usuario?            @relation(fields: [usuarioId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([versionSupermatrizId])
  @@index([tipoEntidad, entidadId])
  @@index([usuarioId])
  @@index([createdAt])
}
