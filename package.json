{
  "name": "stack44-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec \"ts-node --files\" src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "npm run seed:reconstruccion",
    "reset:supermatriz": "ts-node --project tsconfig.seed.json prisma/reset-supermatriz.ts",
    "seed:supermatriz": "ts-node --project tsconfig.seed.json prisma/seed-supermatriz.ts && ts-node --project tsconfig.seed.json prisma/backfill-logica-evaluacion-aspectos.ts",
    "reset:total": "ts-node --project tsconfig.seed.json prisma/reset-total.ts",
    "seed:entorno-base": "ts-node --project tsconfig.seed.json prisma/seed-entorno-base.ts",
    "seed:reconstruccion": "npm run seed:supermatriz && npm run seed:entorno-base",
    "seed:superadmin": "ts-node --project tsconfig.seed.json prisma/seed-superadmin.ts",
    "backfill:gestion-participantes": "ts-node --project tsconfig.seed.json prisma/backfill-gestion-participantes.ts",
    "backfill:logica-evaluacion": "ts-node --project tsconfig.seed.json prisma/backfill-logica-evaluacion-aspectos.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "resend": "^6.9.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.5",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "npm run seed:reconstruccion"
  }
}
