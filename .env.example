# Stack44 server
DATABASE_URL=
JWT_SECRET=
FRONTEND_URL=
ALLOWED_ORIGINS=

# Bitacora SG-SST · IA
# La API key real vive únicamente en .env local / variables de entorno de Render.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.4-mini
OPENROUTER_TIMEOUT_MS=45000

# Opcional. URL pública del frontend de Stack44 para atribución en OpenRouter.
# Puede quedar vacía sin afectar las solicitudes.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Stack44 SG-SST

# Proveedor aprobado para el módulo. Azure figura como zero retention en
# OpenRouter y sirve GPT-5.4 Mini. Mantener en minúsculas como slug base.
OPENROUTER_PROVIDER_ONLY=azure
