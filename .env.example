# Stack44 server
DATABASE_URL=
JWT_SECRET=
FRONTEND_URL=
ALLOWED_ORIGINS=

# Bitacora SG-SST · IA
# La API key real vive únicamente en .env local / variables de entorno de Render.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.4-mini
OPENROUTER_TIMEOUT_MS=90000

# Opcional. URL pública del frontend de Stack44 para atribución en OpenRouter.
# Puede quedar vacía sin afectar las solicitudes.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Stack44 SG-SST

# Orden preferido de proveedores. OpenRouter puede hacer failover a otros
# proveedores compatibles mientras se mantengan ZDR, data_collection=deny y
# require_parameters=true.
OPENROUTER_PROVIDER_ORDER=azure

# Compatibilidad con despliegues anteriores: si OPENROUTER_PROVIDER_ONLY está
# configurado y STRICT_ONLY=false, se interpreta como preferencia de orden para
# no perder failover entre proveedores. Activa STRICT_ONLY solo si existe una
# exigencia real de restringir la inferencia exclusivamente a esa allowlist.
OPENROUTER_PROVIDER_ONLY=
OPENROUTER_PROVIDER_STRICT_ONLY=false
