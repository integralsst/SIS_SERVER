# Stack44 server
DATABASE_URL=
JWT_SECRET=
FRONTEND_URL=
ALLOWED_ORIGINS=

# Bitacora SG-SST · IA
# Mantener desactivado hasta crear la cuenta y configurar la API key real.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.4-mini
OPENROUTER_TIMEOUT_MS=45000
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Stack44 SG-SST

# Opcional: lista separada por comas de proveedores previamente aprobados.
# Si queda vacia, OpenRouter puede seleccionar entre los endpoints que cumplan
# data_collection=deny y zdr=true definidos en el cliente.
OPENROUTER_PROVIDER_ONLY=
